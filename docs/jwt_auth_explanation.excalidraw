      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Important:\n• Header + payload are Base64-encoded, NOT encrypted.\n• Do not put passwords or secrets inside the JWT.\n• If payload is changed, the signature check fails.\n• JwtService.parseClaims() verifies signature and rejects expired tokens.",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 16,
      "containerId": null,
      "originalText": "Important:\n• Header + payload are Base64-encoded, NOT encrypted.\n• Do not put passwords or secrets inside the JWT.\n• If payload is changed, the signature check fails.\n• JwtService.parseClaims() verifies signature and rejects expired tokens.",
      "autoResize": false,
      "lineHeight": 1.25
    },
