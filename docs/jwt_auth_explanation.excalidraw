      "updated": 1,
      "link": null,
      "locked": false,
      "text": "7 scenarios:\n1. Register new user → 201\n2. Duplicate username → 409\n3. Correct login → 200 + JWT\n4. Wrong password → 401, no JWT\n5. Protected endpoint + valid JWT → 200\n6. Protected endpoint without JWT → 401\n7. Protected endpoint with tampered JWT → 401",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 16,
      "containerId": null,
      "originalText": "7 scenarios:\n1. Register new user → 201\n2. Duplicate username → 409\n3. Correct login → 200 + JWT\n4. Wrong password → 401, no JWT\n5. Protected endpoint + valid JWT → 200\n6. Protected endpoint without JWT → 401\n7. Protected endpoint with tampered JWT → 401",
      "autoResize": false,
      "lineHeight": 1.25
    },
